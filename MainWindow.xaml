<Window x:Class="CyberBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberBot"
        mc:Ignorable="d"
        Title="Mainwindow"
        Height="400"
        Width="500"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- HOME GRID -->
        <Grid x:Name="home_grid"
              Visibility="Visible"
              Background="Silver">

            <Image Source="Images/Banner-Logo.jpg"
                   Width="500"
                   Margin="150,24,150,164"/>

            <TextBlock
                Text="WELCOME TO CYBERSECURITY AWARENESS CHATBOT, I AM HERE TO HELP YOU STAY SAFE ONLINE"
                Width="650"
                Height="20"
                Margin="0,161,0,0"
                FontFamily="Arial Rounded MT Bold"
                TextAlignment="Center"/>

            <TextBlock
                Text="Click Proceed to continue..."
                Width="220"
                Height="20"
                Margin="0,210,0,0"
                FontFamily="Arial Rounded MT Bold"
                Foreground="OrangeRed"
                TextAlignment="Center"/>

            <Button
                Width="300"
                Height="40"
                Margin="0,270,0,0"
                Content="Proceed"
                Background="#122452"
                Foreground="Beige"
                Click="proceed"/>

        </Grid>

        <!-- USERNAME GRID -->
        <Grid x:Name="username_grid"
              Visibility="Hidden"
              Background="Silver">

            <Image Source="Images/Banner-Logo.jpg"
                   Width="250"
                   Height="200"
                   Margin="0,0,0,180"/>

            <TextBlock
                Text="Enter Username"
                Width="270"
                Height="20"
                Margin="0,50,0,0"
                FontFamily="Arial Rounded MT Bold"/>

            <TextBox
                x:Name="usernames_input"
                Width="270"
                Height="40"
                Margin="0,105,0,0"
                TextAlignment="Center"
                FontFamily="Arial Rounded MT Bold"/>

            <TextBlock
                x:Name="username_error_label"
                Text="Please enter a username."
                Width="270"
                Height="20"
                Margin="0,185,0,0"
                Foreground="LimeGreen"
                Visibility="Hidden"
                FontFamily="Arial Rounded MT Bold"/>

            <Button
                Width="270"
                Height="40"
                Margin="0,250,0,0"
                Content="Submit Username"
                Background="#122452"
                Foreground="GhostWhite"
                Click="submit_name"/>

        </Grid>
        <!-- 
            CHAT GRID
            This grid handles all messaging and conversation-related features of the application.
            It contains a ListView to display chat messages, a textbox for typing questions,A activity log to see steps taken by the bot
            and a submit button to send the question to the chat.
            Starting in a hidden state.-->
               <!-- CHAT GRID -->
        <Grid x:Name="chat_grid"
              Visibility="Hidden"
              Background="Silver">

            <Grid.ColumnDefinitions>
                <!-- Main Chat -->
                <ColumnDefinition Width="*" />

                <!-- Activity Panel (Hidden until requested) -->
                <ColumnDefinition x:Name="ActivityColumn"
                                  Width="0"/>
            </Grid.ColumnDefinitions>

            
            <!-- CHAT AREA -->
            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="55"/>
                </Grid.RowDefinitions>

                <!-- Quiz Status -->
                <TextBlock
                    x:Name="lblQuizStatus"
                    Grid.Row="0"
                    Margin="10,5"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkBlue"/>

                <!-- Chat Messages -->
                <ListView
                    x:Name="chats"
                    Grid.Row="1"
                    Margin="10,5"/>

                <!-- Quiz Progress -->
                <ProgressBar
                    x:Name="QuizProgress"
                    Grid.Row="2"
                    Margin="10,2"
                    Height="15"
                    Minimum="0"
                    Maximum="10"
                    Value="0"/>

                <!-- User Input -->
                <TextBox
                    x:Name="question"
                    Grid.Row="3"
                    Margin="10"
                    VerticalContentAlignment="Center"
                    FontSize="14"
                    AcceptsReturn="False"
                    TextWrapping="Wrap"/>

                <!-- Send Button -->
                <Button
                    Grid.Row="4"
                    Margin="10"
                    Height="40"
                    Width="200"
                    HorizontalAlignment="Right"
                    Background="#122452"
                    Foreground="White"
                    FontWeight="Bold"
                    Content="Send"
                    Click="send"/>

            </Grid>

            <!-- ========================= -->
            <!-- CYBER DASHBOARD -->
            <!-- ========================= -->

            <Border Grid.Column="1"
        Background="#122452"
        BorderBrush="Black"
        BorderThickness="1">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <!-- Title -->
                        <TextBlock
                Text="Cyber Dashboard"
                FontSize="20"
                FontWeight="Bold"
                Foreground="White"
                HorizontalAlignment="Center"
                Margin="0,5"/>

                        <Separator Margin="0,10"/>

                        <!-- Pending Tasks -->
                        <GroupBox Header="Pending Tasks"
                      Foreground="White"
                      Margin="0,5">

                            <TextBlock
                    x:Name="txtPendingTasks"
                    Text="0"
                    Margin="5"
                    FontWeight="Bold"/>
                        </GroupBox>

                        <!-- Completed Tasks -->
                        <GroupBox Header="Completed Tasks"
                      Foreground="White"
                      Margin="0,5">

                            <TextBlock
                    x:Name="txtCompletedTasks"
                    Text="0"
                    Margin="5"
                    FontWeight="Bold"/>
                        </GroupBox>

                        <!-- Reminder -->
                        <GroupBox Header="Next Reminder"
                      Foreground="White"
                      Margin="0,5">

                            <TextBlock
                    x:Name="txtReminderStatus"
                    Text="No reminders scheduled."
                    Margin="5"
                    TextWrapping="Wrap"/>
                        </GroupBox>

                        <!-- Quiz -->
                        <GroupBox Header="Last Quiz Score"
                      Foreground="White"
                      Margin="0,5">

                            <TextBlock
                    x:Name="txtQuizScore"
                    Text="No quiz completed."
                    Margin="5"
                    FontWeight="Bold"/>
                        </GroupBox>

                        <!-- Last Topic -->
                        <GroupBox Header="Last Security Topic"
                      Foreground="White"
                      Margin="0,5">

                            <TextBlock
                    x:Name="txtLastTopic"
                    Text="None"
                    Margin="5"/>
                        </GroupBox>

                        <!-- Activity -->
                        <GroupBox Header="Recent Activity"
                      Foreground="White"
                      Margin="0,5">

                            <ListBox
                    x:Name="lstActivityLog"
                    Height="250"
                    Background="#122452"
                    Foreground="White"/>
                        </GroupBox>

                    </StackPanel>

                </ScrollViewer>

            </Border>
        </Grid>

    </Grid>

</Window>
